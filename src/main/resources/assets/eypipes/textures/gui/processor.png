<?xml version="1.0" encoding="UTF-8"?>
<svg width="176" height="166" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="176" height="166" fill="#c6c6c6" stroke="#8b8b8b" stroke-width="1"/>
  
  <!-- Main GUI area -->
  <rect x="7" y="16" width="162" height="54" fill="#8b8b8b" stroke="#373737" stroke-width="1"/>
  
  <!-- Input slots background -->
  <rect x="43" y="34" width="72" height="36" fill="#373737" stroke="#000000" stroke-width="1"/>
  
  <!-- Input slot outlines -->
  <rect x="44" y="35" width="16" height="16" fill="#8b8b8b" stroke="#373737" stroke-width="1"/>
  <rect x="62" y="35" width="16" height="16" fill="#8b8b8b" stroke="#373737" stroke-width="1"/>
  <rect x="80" y="35" width="16" height="16" fill="#8b8b8b" stroke="#373737" stroke-width="1"/>
  <rect x="98" y="35" width="16" height="16" fill="#8b8b8b" stroke="#373737" stroke-width="1"/>
  <rect x="44" y="53" width="16" height="16" fill="#8b8b8b" stroke="#373737" stroke-width="1"/>
  <rect x="62" y="53" width="16" height="16" fill="#8b8b8b" stroke="#373737" stroke-width="1"/>
  <rect x="80" y="53" width="16" height="16" fill="#8b8b8b" stroke="#373737" stroke-width="1"/>
  <rect x="98" y="53" width="16" height="16" fill="#8b8b8b" stroke="#373737" stroke-width="1"/>
  
  <!-- Progress arrow background -->
  <rect x="116" y="44" width="24" height="16" fill="#373737" stroke="#000000" stroke-width="1"/>
  
  <!-- Output slot -->
  <rect x="152" y="44" width="16" height="16" fill="#8b8b8b" stroke="#373737" stroke-width="1"/>
  
  <!-- Player inventory background -->
  <rect x="7" y="83" width="162" height="76" fill="#8b8b8b" stroke="#373737" stroke-width="1"/>
  
  <!-- Progress arrow texture (at x=176 for the progress overlay) -->
  <g transform="translate(176, 0)">
    <polygon points="0,0 24,0 24,16 0,16" fill="#ff6b35"/>
    <polygon points="2,2 22,8 2,14" fill="#ff8c42"/>
  </g>
</svg>